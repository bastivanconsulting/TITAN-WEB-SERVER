{
    "http_port": ":8080",
    "https_port": ":8443",
    "admin_api_key": "change-this-secret-key",
    "admin_user": "admin",
    "admin_pass": "change-this-password",
    "admin_allowlist": [
        "127.0.0.1",
        "::1"
    ],
    "log_dir": "/var/log/titan/",
    "conf_dir": "conf.d/",
    "cache": null,
    "security": {
        "fips_compliant": true
    },
    "sites": [
        {
            "domain": "www.example.com",
            "routes": [
                {
                    "path": "/",
                    "type": "static",
                    "proxy_target": "",
                    "file_root": "/var/www/example.com/public"
                }
            ],
            "ssl": {
                "enabled": true,
                "email": "webmaster@example.com",
                "cert_file": "",
                "key_file": "",
                "provider": "letsencrypt",
                "hsts": {
                    "enabled": true,
                    "max_age": 31536000,
                    "include_subdomains": true,
                    "preload": true
                },
                "ocsp_stapling": true
            }
        },
        {
            "domain": "app.internal.local",
            "routes": [
                {
                    "path": "/",
                    "type": "proxy",
                    "proxy_target": "http://127.0.0.1:3000",
                    "file_root": ""
                }
            ],
            "ssl": {
                "enabled": true,
                "email": "",
                "cert_file": "/etc/ssl/certs/app.crt",
                "key_file": "/etc/ssl/private/app.key",
                "provider": "manual",
                "ocsp_stapling": false
            }
        },
        {
            "domain": "bc-vm-82-21-0-53-eu-west-par.bastivan.cloud",
            "routes": [
                {
                    "path": "/",
                    "type": "php",
                    "proxy_target": "127.0.0.1:9000",
                    "upstreams": [
                        "127.0.0.1:9000"
                    ],
                    "file_root": "/var/www/titan/public/"
                }
            ]
        },
        {
            "domain": "localhost",
            "routes": [
                {
                    "path": "/google",
                    "type": "proxy",
                    "proxy_target": "http://google.com",
                    "file_root": ""
                },
                {
                    "path": "/",
                    "type": "static",
                    "proxy_target": "",
                    "file_root": "./test_static"
                }
            ]
        }
    ]
}
